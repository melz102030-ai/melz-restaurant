rules_version = '2';

// قواعد أمان Firestore لتطبيق Meals.
//
// إنشاء الطلبات وأرقامها يتم حصراً في الخادم (cloudflare/lean-payments) بحساب
// الخدمة الذي لا تسري عليه هذه القواعد، وهو من يحسب السعر والإجمالي من القائمة
// الحية. ما تضمنه هذه القواعد:
//   • كل كتابة تتطلب مستخدماً مسجّلاً بالدور الصحيح (لا اعتماد على إخفاء
//     الأزرار في الواجهة فقط).
//   • حقول السعر (subtotal/deliveryFee/total/items) غير قابلة للتعديل بعد
//     إنشاء الطلب من أي طرف.
//   • لا يمكن لأي مستخدم تصعيد صلاحياته (role وما يتبعه) عبر الكتابة المباشرة،
//     والحسابات المجهولة (الضيوف) لا تُعامَل كموظفين إطلاقاً مهما كان في ملفها.
//   • لا يستطيع أي متصفح إنشاء طلب أو تعديل عدّاد أرقام الطلبات مباشرة.

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────── دوال مساعدة ────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // الضيوف (طلب بلا تسجيل دخول) يستخدمون Firebase Anonymous Auth، بينما كل
    // موظف يدخل برقم وكلمة مرور (loginStaff) — لذلك لا يُعتدّ بأي دور موظف في
    // ملف حساب مجهول، حتى لو كان مكتوباً فيه من قبل إغلاق هذا الاستثناء.
    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() { return isSignedIn() && !isAnonymous() && myRole() == 'admin'; }
    function isKitchen() { return isSignedIn() && !isAnonymous() && myRole() == 'kitchen'; }
    function isDriver() { return isSignedIn() && !isAnonymous() && myRole() == 'driver'; }
    function isStaff() { return isAdmin() || isKitchen() || isDriver(); }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // نفس رقم المدير الأعلى في lib/core/constants/system_admins.dart
    function isSuperPhone(phone) {
      return phone in ['0531131125', '966531131125', '+966531131125', '00966531131125'];
    }

    function isSuperAdmin() { return isAdmin() && isSuperPhone(me().get('phone', '')); }

    function isSystemAdmin() {
      return isAdmin() && (isSuperPhone(me().get('phone', '')) ||
        me().get('systemRole', 'none') == 'assistantAdmin');
    }

    // صلاحيات المدير المفصلة، مطابقة لـ UserModel.hasPermission: مدير النظام له كل
    // شيء، والمدير بلا صلاحيات محددة له كل شيء (التهيئة القديمة)، وغيره حسب ما حُدد له
    function hasPerm(key) {
      return isAdmin() && (isSystemAdmin() ||
        me().get('permissions', {}).size() == 0 ||
        me().get('permissions', {}).get(key, false) == true);
    }

    // مسح سجل الطلبات نهائياً: للمدير الأعلى، أو لمن منحه إياها صراحة. لا تشملها
    // «كل الصلاحيات» للمدير بلا صلاحيات محددة ولا لمساعد المدير
    function canClearHistory() {
      return isSuperAdmin() ||
        (isAdmin() && me().get('permissions', {}).get('clearHistory', false) == true);
    }

    // لا يمنح صلاحية المسح ولا يسحبها إلا المدير الأعلى
    function clearHistoryGrant(data) {
      return data.get('permissions', {}).get('clearHistory', false) == true;
    }

    function clearHistoryGrantUnchanged() {
      return isSuperAdmin() ||
        clearHistoryGrant(request.resource.data) == clearHistoryGrant(resource.data);
    }

    // المدير الأعلى لا يعدّله غيره، ومساعد المدير لا يعدّله إلا نفسه والمدير الأعلى
    function canManageUser(userId, target) {
      return request.auth.uid == userId || isSuperAdmin() ||
        (!isSuperPhone(target.get('phone', '')) &&
          target.get('systemRole', 'none') != 'assistantAdmin');
    }

    // الحقول التي تحدد الصلاحيات — لا يعدّلها إلا الأدمن
    function privilegedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'extraRoles', 'systemRole', 'permissions']);
    }

    // ملف عميل جديد بلا أي صلاحية إضافية
    function isPlainCustomerProfile() {
      let d = request.resource.data;
      return d.role == 'customer' &&
        d.get('extraRoles', []).size() == 0 &&
        d.get('systemRole', 'none') == 'none' &&
        d.get('permissions', {}).size() == 0;
    }

    // حدود طول ما يكتبه العميل، حتى لا يربك نص ضخم شاشة المطبخ والفاتورة والدعم.
    // نفس الأرقام في حقول الإدخال وفي الخادم (pricing.js)
    function shortText(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    function profileTextOk() {
      let d = request.resource.data;
      return shortText(d.get('name', null), 60) && shortText(d.get('phone', null), 20);
    }

    function supportMessageOk(m) {
      return m.text is string && m.text.size() <= 1000 &&
        shortText(m.get('senderName', null), 60);
    }

    // ─────────────────────────────── users ───────────────────────────────
    match /users/{userId} {
      // كل مستخدم يقرأ ملفه فقط لحماية أرقام العملاء ومواقعهم. الأدمن للوحة
      // المستخدمين، والمطبخ لقائمة المناديب عند تعيين مندوب على طلب.
      allow read: if isSignedIn() &&
        (request.auth.uid == userId || isAdmin() || isKitchen());

      // إنشاء الحساب: المستخدم نفسه كعميل عادي بلا صلاحيات (الضيف عند أول طلب)،
      // أو الأدمن عند إنشاء موظف مطبخ/مندوب من لوحة التحكم.
      allow create: if isSignedIn() && (
        (hasPerm('users') && (isSuperAdmin() || !clearHistoryGrant(request.resource.data))) ||
        (request.auth.uid == userId && isPlainCustomerProfile() && profileTextOk())
      );

      // تعديل الحساب: صاحب صلاحية الأعضاء يعدّل غيره ضمن canManageUser، ولا يرفع
      // صلاحيات نفسه إلا مدير النظام. ودرجة مدير النظام يمنحها المدير الأعلى فقط.
      // ولا يأخذ أحد رقم المدير الأعلى، ولا يغيّر الموظف رقمه لأنه اسم دخوله.
      // والمستخدم نفسه يعدّل بياناته (الاسم، التوفّر، الموقع المحفوظ...) فقط.
      allow update: if isSignedIn() &&
        (request.resource.data.get('phone', '') == resource.data.get('phone', '') ||
          !isSuperPhone(request.resource.data.get('phone', ''))) && (
        (hasPerm('users') && canManageUser(userId, resource.data) && clearHistoryGrantUnchanged() &&
          (isSuperAdmin() ||
            request.resource.data.get('systemRole', 'none') == resource.data.get('systemRole', 'none')) &&
          (request.auth.uid != userId || isSystemAdmin() || privilegedFieldsUnchanged())) ||
        (request.auth.uid == userId && privilegedFieldsUnchanged() && profileTextOk() &&
          (resource.data.role == 'customer' ||
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone'])))
      );

      allow delete: if hasPerm('users') && canManageUser(userId, resource.data);
    }

    // ─────────────────────────────── orders ──────────────────────────────
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        isAdmin() || isKitchen() ||
        (isDriver() && resource.data.driverId == request.auth.uid) ||
        resource.data.customerId == request.auth.uid
      );

      // الإنشاء عبر الخادم فقط، حتى لا يكتب أي متصفح طلباً بسعر من عنده
      allow create: if false;

      // التعديل: ثلاث حالات فقط، ولا يجوز لأيٍّ منها تعديل الأصناف أو الأسعار
      // أو صاحب الطلب بعد الإنشاء.
      allow update: if isSignedIn() && _priceFieldsUnchanged() && _statusChangeAllowed() && (
        // 1) المطبخ/الأدمن: إدارة الحالة والتحضير وتعيين/إلغاء المندوب —
        //    باستثناء إلغاء تعيين مندوب يحمل الطلب بالفعل (outForDelivery).
        ((isKitchen() || hasPerm('orders') || hasPerm('kitchen')) &&
          !(resource.data.status == 'outForDelivery' &&
            request.resource.data.driverId == null)) ||
        // 2) المندوب: فقط على طلبه المُسنَد له (قبول/رفض، تأكيد استلام،
        //    بث الموقع الحي، تسليم).
        (isDriver() && resource.data.driverId == request.auth.uid) ||
        // 3) العميل: إلغاء طلبه الخاص فقط، طالما لا يزال قيد الانتظار، أو إن
        //    أبلغه المطبخ بنفاد أصنافه ولم يخرج الطلب للتوصيل بعد.
        (resource.data.customerId == request.auth.uid &&
          (resource.data.status == 'pending' ||
            (resource.data.get('unavailableItemIds', []).size() > 0 &&
              resource.data.status in ['confirmed', 'preparing', 'ready'])) &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])) ||
        // 4) العميل أيضاً: رفع إيصال التحويل البنكي اليدوي على طلبه هو فقط،
        //    لطلبات التحويل البنكي غير المُلغاة — حقل واحد بلا أي صلاحية أخرى.
        //    القيمة صيغة الملف فقط وليست رابطاً، فلا يمرر العميل رابطاً تفتحه الإدارة.
        (resource.data.customerId == request.auth.uid &&
          resource.data.paymentMethod == 'manualBankTransfer' &&
          resource.data.status != 'cancelled' &&
          request.resource.data.paymentReceiptUrl.matches('receipt[.](jpg|jpeg|png|pdf)') &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paymentReceiptUrl', 'updatedAt']))
      );

      allow delete: if hasPerm('orders') || canClearHistory();

      // الطلب يتقدم خطوة خطوة ولا يرجع، والمسلَّم والملغى نهائيان حتى للمدير
      function _statusChangeAllowed() {
        let from = resource.data.status;
        let to = request.resource.data.status;
        return from == to ||
          (from == 'pending' && to in ['confirmed', 'cancelled']) ||
          (from == 'confirmed' && to in ['preparing', 'cancelled']) ||
          (from == 'preparing' && to in ['ready', 'cancelled']) ||
          (from == 'ready' && to in ['outForDelivery', 'delivered', 'cancelled']) ||
          (from == 'outForDelivery' && to in ['delivered', 'cancelled']);
      }

      function _priceFieldsUnchanged() {
        return request.resource.data.customerId == resource.data.customerId &&
          request.resource.data.items == resource.data.items &&
          request.resource.data.subtotal == resource.data.subtotal &&
          request.resource.data.deliveryFee == resource.data.deliveryFee &&
          request.resource.data.total == resource.data.total &&
          request.resource.data.paymentMethod == resource.data.paymentMethod;
      }
    }

    // ───────────────────── محتوى عام: قراءة للجميع، كتابة للأدمن ─────────────
    // القائمة والفئات وقوالب الخيارات ومناطق التوصيل والإعدادات والبانرات
    // والإعلانات وصور شاشة التحميل — يحتاج الزوّار غير المسجَّلين لقراءتها
    // لتصفّح القائمة والسعر قبل تسجيل الدخول.
    match /categories/{id}       { allow read: if true; allow write: if hasPerm('menu'); }
    match /combos/{id}           { allow read: if true; allow write: if hasPerm('menu'); }
    match /menu_items/{id} {
      allow read: if true;
      allow write: if hasPerm('menu');
      // المطبخ: تبديل "متوفر/نفد من المطعم" فقط — بلا أي صلاحية أخرى
      // (شاشة توفر الأصناف في واجهة المطبخ تحتاج هذا تحديداً)
      allow update: if isKitchen() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAvailable']);
    }
    match /option_templates/{id} { allow read: if true; allow write: if hasPerm('menu'); }
    match /deliveryZones/{id}    { allow read: if true; allow write: if hasPerm('delivery'); }
    match /promo_banners/{id}    { allow read: if true; allow write: if hasPerm('content'); }
    match /popup_ads/{id}        { allow read: if true; allow write: if hasPerm('content'); }
    match /splash_images/{id}    { allow read: if true; allow write: if hasPerm('content'); }
    // ملخصات الأيام المنتهية، يحفظها التقرير حتى لا يعيد قراءة كل الطلبات
    match /daily_summaries/{id}  { allow read, write: if hasPerm('reports') || canClearHistory(); }
    // مستند واحد تكتبه عدة شاشات: الإعدادات والمظهر وساعات العمل والتوصيل والكولاج
    // وزر فتح المطعم وإغلاقه في لوحة التحكم
    match /settings/{docId} {
      allow read: if true;
      allow write: if hasPerm('settings') || hasPerm('appearance') || hasPerm('workHours') ||
        hasPerm('delivery') || hasPerm('content') || hasPerm('dashboard');
    }

    // مجموعة أرقام الطلبات العشوائية غير المتكررة (4 خانات) — يسحب منها الخادم
    // عند إنشاء كل طلب، فلا حاجة لأي كتابة من المتصفح
    match /counters/{id} {
      allow read: if true;
      allow write: if false;
    }

    // أرقام العملاء التي وثّقها المطبخ بعد الاتصال بهم — بيانات عملاء، فلا تُقرأ
    // ولا تُكتب إلا من المطبخ والأدمن
    match /verified_phones/{phone} {
      allow read, write: if isKitchen() || hasPerm('kitchen') || hasPerm('orders');
    }

    // ───────────────────────── تذاكر الدعم الفني ────────────────────────────
    match /support_tickets/{id} {
      allow read: if isSignedIn() &&
        (isAdmin() || resource.data.customerId == request.auth.uid);

      // الإنشاء: العميل فقط، لنفسه، تذكرة مفتوحة برسالة واحدة أولية
      allow create: if isSignedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.messages.size() == 1 &&
        request.resource.data.messages[0].senderRole == 'customer' &&
        supportMessageOk(request.resource.data.messages[0]) &&
        shortText(request.resource.data.get('customerName', null), 60) &&
        shortText(request.resource.data.get('customerPhone', null), 20) &&
        shortText(request.resource.data.get('category', null), 40);

      // الأدمن: الردّ وتغيير الحالة على أي تذكرة بلا تغيير صاحبها. العميل على
      // تذكرته: إضافة رسالته في آخر القائمة فقط، بلا تعديل ما قبلها أو كتابة رد
      // باسم الدعم، وله إعادة فتحها لا إغلاقها.
      allow update: if isSignedIn() && (
        (hasPerm('support') &&
          request.resource.data.customerId == resource.data.customerId) ||
        (resource.data.customerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['messages', 'updatedAt', 'status']) &&
          (request.resource.data.status == resource.data.status ||
            request.resource.data.status == 'open') &&
          request.resource.data.messages.size() == resource.data.messages.size() + 1 &&
          request.resource.data.messages[0:resource.data.messages.size()] == resource.data.messages &&
          request.resource.data.messages[resource.data.messages.size()].senderRole == 'customer' &&
          supportMessageOk(request.resource.data.messages[resource.data.messages.size()]) &&
          request.resource.data.messages.size() <= 200)
      );
    }
  }
}
