<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- لازمة على أندرويد 11+ حتى يقدر هذا التطبيق يكتشف خدمة الطابعة
         الداخلية المثبَّتة مسبقاً على جهاز Sunmi (قيود رؤية الحزم) -->
    <queries>
        <package android:name="woyou.aidlservice.jiuiv5" />
    </queries>

    <application
        android:label="طباعة Meals"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/BridgeTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/BridgeTheme">
            <!-- يستقبل روابط sunmiprint://print?data=... من متصفح كروم
                 (تطبيق Meals، نسخة kitchen-lite العاملة على مسار /k/) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sunmiprint" android:host="print" />
            </intent-filter>
        </activity>
    </application>
</manifest>
